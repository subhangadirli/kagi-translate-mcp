{
  "name": "kagi-translate-mcp",
  "version": "0.1.2",
  "description": "MCP server for Kagi Translate",
  "license": "LGPL-2.1-only",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint --ext .ts src",
    "pretest": "pnpm run lint",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/index.js",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.1",
    "dotenv": "^16.4.7",
    "zod": "^4.4.3",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@typescript-eslint/typescript-estree": "^8.59.4",
    "eslint": "^8.57.1",
    "minimatch": "^10.2.5",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subhangadirli/kagi-translate-mcp.git"
  },
  "homepage": "https://github.com/subhangadirli/kagi-translate-mcp#readme",
  "author": "subhangadirli <subhanqedirli@protonmail.com>",
  "keywords": [
    "mcp",
    "kagi",
    "translate",
    "mcp-server"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
  ,"packageManager": "pnpm@11.2.2"
}
